{
  "name": "nationzero",
  "productName": "NationZero",
  "version": "1.0.0",
  "description": "Simulador de poder: crie seu país, suba ao poder, escreva leis, dê golpes e decida o destino da nação.",
  "author": {
    "name": "Veexdevs",
    "email": "veexdevs@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/Veexdevs/NationZero",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "serve": "node scripts/serve.js",
    "test": "node scripts/test.js",
    "icons": "bash scripts/make-icons.sh",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:all": "electron-builder -mwl",
    "test:ui": "node scripts/ui-test.mjs",
    "test:all": "npm test && npm run test:ui"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "@capacitor/cli": "^6.1.2",
    "jsdom": "^24.1.3"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "build": {
    "appId": "com.veexdevs.nationzero",
    "productName": "NationZero",
    "copyright": "Copyright © 2026 Veexdevs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "build/icon.png",
      "package.json"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "NationZero-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NationZero"
    },
    "portable": {
      "artifactName": "NationZero-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.strategy-games",
      "icon": "build/icon.png",
      "artifactName": "NationZero-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "NationZero-${version}-${arch}.${ext}"
    }
  }
}
