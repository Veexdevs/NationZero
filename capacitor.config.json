{
  "appId": "com.veexdevs.nationzero",
  "appName": "NationZero",
  "webDir": "www",
  "bundledWebRuntime": false,
  "backgroundColor": "#060b0a",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always",
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false
  },
  "server": {
    "androidScheme": "https"
  }
}
